<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Windows gives the shim a console only when its caller has one to share, so an
  editor that starts it detached opens no extra window. Windows 11 24H2 (build
  26100) and later read this setting.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application>
    <windowsSettings>
      <consoleAllocationPolicy xmlns="http://schemas.microsoft.com/SMI/2024/WindowsSettings">detached</consoleAllocationPolicy>
    </windowsSettings>
  </application>
</assembly>
